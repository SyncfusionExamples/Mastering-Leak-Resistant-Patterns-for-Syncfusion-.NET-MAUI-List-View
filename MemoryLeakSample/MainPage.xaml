<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MemoryLeakSample.MainPage"
             Title="Leak Prevention Samples">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Syncfusion .NET MAUI ListView - Leak Prevention Samples" FontAttributes="Bold" FontSize="18"/>
            <Label Text="Navigate to each page to see recommended patterns in action." FontSize="12" TextColor="Gray"/>

            <Button Text="1) Fixed: Events cleanup" Clicked="OpenFixedEvents"/>
            <Button Text="2) Fixed: ItemTemplate cleanup" Clicked="OpenFixedTemplate"/>
            <Button Text="3) Fixed: Messaging &amp; timers" Clicked="OpenFixedMessaging"/>
            <Button Text="4) Best practices (combined)" Clicked="OpenBestPractices"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
